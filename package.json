{
  "name": "stride-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@types/jest": "29.5.14",
    "expo": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "react-test-renderer": "^19.2.3",
    "playwright-core": "^1.49.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "landing": "npx --yes serve landing -l 3000",
    "build:apk": "eas build --platform android --profile production --wait",
    "build:apk:production": "bash scripts/build-lite-apk.sh",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "build:apk:local": "bash scripts/build-apk-local.sh",
    "build:apk:landing": "bash scripts/build-lite-apk.sh",
    "verify": "npm test && tsc --noEmit && npx expo-doctor && node scripts/verify-release.mjs && npm run test:landing",
    "verify:release": "npm test && tsc --noEmit && npx expo-doctor && node scripts/verify-release.mjs --require-apk --require-release-signing && npm run test:landing",
    "test": "jest",
    "test:landing": "node scripts/landing-e2e.mjs",
    "qa:android": "bash scripts/qa-android-device.sh"
  },
  "private": true
}
