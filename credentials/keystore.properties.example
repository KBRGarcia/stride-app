# Copia a credentials/keystore.properties (gitignored) o usa:
#   export STRIDE_KEYSTORE_PASSWORD='...'
#   bash scripts/ensure-release-keystore.sh
# PKCS12 (stride-release.keystore): storePassword y keyPassword deben ser iguales.
storeFile=stride-release.keystore
storePassword=CAMBIAR
keyAlias=stride-release
keyPassword=CAMBIAR
